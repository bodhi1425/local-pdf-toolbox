{
  "name": "local-pdf-toolbox",
  "private": true,
  "version": "1.0.0",
  "description": "纯本地 PDF 工具箱 — 合并/拆分/压缩/转图片，文件不上传",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-pages.mjs",
    "dev": "node scripts/gen-pages.mjs && vite",
    "build": "node scripts/gen-pages.mjs && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
